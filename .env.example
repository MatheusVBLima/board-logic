# Copie este arquivo para .env.local e preencha com os dados do SEU Supabase.
# Veja setup.md para criar o banco e configurar o login.
# Project URL: painel do projeto > Connect (ou Settings > Data API).
NEXT_PUBLIC_SUPABASE_URL=https://seu-project-ref.supabase.co
# Publishable key: Settings > API Keys > Publishable key (sb_publishable_...).
# Esta chave publica pode ser usada no navegador; o acesso e protegido por RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA_PELA_SUA_CHAVE
# Alternativa para projetos com chave legada: use anon em vez de publishable.
# Remova a linha PUBLISHABLE_KEY acima antes de descomentar a linha abaixo.
# Se ambas estiverem definidas, ANON_KEY tem prioridade no codigo atual.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=SUBSTITUA_PELA_SUA_CHAVE_ANON
# Nunca use service_role, sb_secret_... ou a senha do banco nestas variaveis.
